{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://penumbra-spec.example/schemas/decoy-content.schema.json",
  "title": "Penumbra executable profile decoy content",
  "type": "object",
  "additionalProperties": false,
  "required": ["profileVersion", "decoyId", "credibilityTier", "locale", "content"],
  "properties": {
    "profileVersion": { "const": "0.1" },
    "decoyId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "credibilityTier": { "enum": ["Glance", "Inspection", "Sustained"] },
    "locale": { "type": "string", "minLength": 2, "maxLength": 35, "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$" },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "items"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "items": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "description"],
            "properties": {
              "title": { "type": "string", "minLength": 1, "maxLength": 200 },
              "description": { "type": "string", "minLength": 1, "maxLength": 2000 }
            }
          }
        }
      }
    }
  }
}
